# ============ 基础 ============
DEBUG=0
HOST=0.0.0.0
PORT=8000
# 数据库：默认 SQLite（相对项目根目录）。可切换 MySQL，例如：
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/monitor
DATABASE_URL=sqlite:///./data/monitor.db

# ============ 抓取 / 风控 ============
# 日本 IP 代理池（http 代理，多个用逗号分隔，自动轮换）。国内 IP 大概率被限流，建议必填。
# 注意：Web 面板「代理池」中启用的代理优先于此处配置；面板为空时才用这里的兜底。
PROXY_LIST=
# 未配置代理时是否允许直连（1=允许，0=禁止）
ALLOW_DIRECT=1
REQUEST_TIMEOUT=20
# 连续失败达到该次数后自动降频
FAILURE_DOWNGRADE_THRESHOLD=3

# ============ 通知渠道（不填的渠道自动跳过）============
# Telegram（推荐主通道）：@BotFather 创建机器人拿 token；向机器人发消息后在 @userinfobot 查你的 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 钉钉群机器人 webhook（可选加签密钥）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Bark (iOS)
BARK_KEY=
BARK_SERVER=https://api.day.app

# 企业微信群机器人 webhook
WECOM_WEBHOOK=

# 微信公众号（第三方通道，任选其一即可）
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
WXPUSHER_APP_TOKEN=
WXPUSHER_TOPIC_ID=
SERVERCHAN_SENDKEY=

# 邮件 SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# 通用 Webhook
WEBHOOK_URL=

# ============ 默认配置 ============
# 默认监控频率（秒）
DEFAULT_INTERVAL=300
# 默认启用渠道（逗号分隔）
DEFAULT_CHANNELS=telegram,dingtalk,bark
# 日元→人民币汇率（仅用于推送展示，可按需更新）
JPY_CNY_RATE=0.048
